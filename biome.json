{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.jsx",
      "**/*.json",
      "!**/dist/**",
      "!**/node_modules/**",
      "!**/.playwright-mcp/**",
      "!.claude/**",
      "!packages/mcp-server/dist/**",
      "!packages/mcp-server/coverage/**",
      "!packages/mcp-server/tmp/**",
      "!**/pnpm-lock.yaml",
      "!.mcp.json",
      "!docs/reference/x-whiteboard.schema.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "off",
        "noArrayIndexKey": "off",
        "useBiomeIgnoreFolder": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off"
      },
      "complexity": {
        "noUselessTypeConstraint": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        ".claude-plugin/marketplace.json",
        ".claude-plugin/plugin.json",
        ".codex-plugin/plugin.json",
        "gemini-extension.json",
        "server.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/mcp-server/src/server/**/*.ts",
        "!packages/mcp-server/src/server/log.ts",
        "!packages/mcp-server/src/server/**/*.test.ts",
        "!packages/mcp-server/src/server/**/*.smoke-impl.ts",
        "!packages/mcp-server/src/server/**/*.distribution-impl.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.tsx",
        "!apps/web/src/**/*.test.ts",
        "!apps/web/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mjs",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test.mjs",
        "!**/test-utils/**",
        "!apps/web/scripts/smoke-bundle-size.mjs",
        "!apps/web/scripts/strip-wasm-sourcemap.ts",
        "!apps/web/src/App.tsx",
        "!apps/web/src/components/AppShell.tsx",
        "!apps/web/src/components/StorageReportCard.tsx",
        "!apps/web/src/components/VersionTimeline.tsx",
        "!apps/web/src/components/annotations/CommentsPanel.tsx",
        "!apps/web/src/components/markdown-editor/MarkdownEditor.tsx",
        "!apps/web/src/components/spatial-editor/SpatialEditor.tsx",
        "!packages/canvas-render/src/layout/nodes/mdast-blocks.ts",
        "!packages/canvas-viewer/scripts/smoke-widget.mjs",
        "!packages/canvas-viewer/src/widget-entry.ts",
        "!packages/mcp-server/scripts/smoke/mcp-e2e-smoke.mjs",
        "!packages/mcp-server/scripts/smoke/mcp-http-convergence-smoke.mjs",
        "!packages/mcp-server/scripts/smoke/mcp-read-plane-smoke.mjs",
        "!tests/e2e/distribution/packaged-server-mode-cli-smoke.mjs"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "path": "./tools/biome-plugins/test-flake-shapes.grit",
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.browser.test.ts", "**/*.browser.test.tsx"]
    },
    {
      "path": "./tools/biome-plugins/browser-test-shapes.grit",
      "includes": ["**/*.browser.test.ts", "**/*.browser.test.tsx"]
    },
    {
      "path": "./tools/biome-plugins/logger-argument-order.grit",
      "includes": ["**/packages/mcp-server/src/server/**/*.ts", "!**/*.test.ts"]
    },
    {
      "path": "./tools/biome-plugins/route-refusal-shapes.grit",
      "includes": [
        "**/packages/mcp-server/src/server/routes/**/*.ts",
        "**/packages/server-core/src/**/*.ts",
        "!**/*.test.ts"
      ]
    }
  ]
}

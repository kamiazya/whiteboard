# .dockerignore — excludes files that must not enter the Docker build context.

# Secrets and local env files (never bake credentials into the image).
.env
.env.*
*.env
!.env.server.example

# Version control
.git
.gitignore

# CI/tooling/IDE config
.github
.claude
.vscode
.idea
*.code-workspace

# Build artifacts regenerated inside the Docker build stages.
# ** matches at any depth — without it, node_modules/ only excludes
# the root directory, and host-side GVS symlinks in nested packages
# (e.g. packages/canvas-model/node_modules/) leak into the build
# context and overwrite the correctly-installed Docker-layer symlinks.
**/node_modules/
**/dist/
packages/mcp-server/coverage/
packages/mcp-server/tmp/

# Test suites and distribution smokes (not needed to build the image).
tests/

# Documentation (not needed at runtime).
docs/

# Temporary files.
tmp/
*.log
*.tgz

# macOS / Windows metadata.
.DS_Store
Thumbs.db

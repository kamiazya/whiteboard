{
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "canvas"],
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["daemon", "browser-local"] }
      }
    },
    "canvas": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workspaceId", "path"],
          "properties": {
            "kind": { "type": "string", "const": "daemon" },
            "workspaceId": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "documentId"],
          "properties": {
            "kind": { "type": "string", "const": "browser-local" },
            "documentId": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    }
  }
}

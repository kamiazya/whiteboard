{
  "compilerOptions": {
    "target": "ES2022",
    // ES2024.Promise only: `Promise.withResolvers` is Chrome 119 / Firefox 121 /
    // Safari 17.4, below the floor the app already needs (WebAuthn PRF, local
    // network access, OPFS), and `build.target` is `esnext`, so nothing is
    // transpiled or polyfilled that would hide a missing global.
    "lib": ["ES2022", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "vite-plugin-svgr/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}

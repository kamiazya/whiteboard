# font-src 'self' data: — Excalidraw's font subsetter emits per-glyph fonts
# as `data:font/woff2;base64,…` URLs, which `default-src 'self'` alone does
# not cover. No `blob:` here: add it only if a captured console repro shows
# Excalidraw actually needs it.
#
# unload is intentionally NOT allowed via Permissions-Policy: Chrome already
# refuses to fire it, and @excalidraw/excalidraw's own `unload` listener is
# neutralized client-side (see src/lib/unload-shim.ts) rather than by
# re-permitting the deprecated behavior here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; worker-src 'self'

# Cloudflare Pages applies the most specific matching path, so these two
# path-scoped rules layer on top of `/*` above rather than replacing it.
# The service worker script must always revalidate: a long-lived cache here
# would strand clients on a stale SW indefinitely (no update toast could ever
# fire because the browser never re-fetches sw.js to notice the change).
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

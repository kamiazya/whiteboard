{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    // The script tests import `scripts/*.mjs`; without it each import is an
    // implicit-any error. Unchecked: the scripts run as plain node.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "scripts/**/*.test.ts", "vite.config.ts", "vitest.node.config.ts"]
}

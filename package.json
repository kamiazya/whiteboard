{
  "name": "@kamiazya/whiteboard-plugin",
  "version": "0.0.11",
  "description": "Claude Code and Codex plugin wrapper surfaces for the whiteboard MCP server and shared skills.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamiazya/whiteboard.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:coverage": "pnpm --filter @kamiazya/whiteboard-mcp test:coverage",
    "test:node": "vitest run --project mcp-node --project mcp-jsdom",
    "test:distribution": "pnpm --filter @kamiazya/whiteboard-mcp test:distribution",
    "test:browser": "vitest run --project mcp-browser --project web-browser",
    "test:browser:trace": "vitest run --project mcp-browser --project web-browser --browser.trace=on",
    "test:watch": "vitest --project mcp-node --project mcp-jsdom",
    "check:pr-title": "pnpm --filter @kamiazya/whiteboard-mcp check:pr-title",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @kamiazya/whiteboard-mcp dev",
    "mcp": "pnpm --filter @kamiazya/whiteboard-mcp mcp",
    "mcp:http": "pnpm --filter @kamiazya/whiteboard-mcp mcp:http",
    "mcp:http:dev": "pnpm --filter @kamiazya/whiteboard-mcp mcp:http:dev",
    "mcp:inspect": "pnpm --filter @kamiazya/whiteboard-mcp mcp:inspect",
    "mcp:inspect:stdio": "pnpm --filter @kamiazya/whiteboard-mcp mcp:inspect:stdio",
    "mcp:debug:http": "pnpm --filter @kamiazya/whiteboard-mcp mcp:debug:http",
    "smoke": "pnpm --filter @kamiazya/whiteboard-mcp smoke",
    "smoke:e2e": "pnpm --filter @kamiazya/whiteboard-mcp smoke:e2e",
    "smoke:packaged": "pnpm --filter @kamiazya/whiteboard-mcp smoke:packaged",
    "smoke:tarball": "pnpm --filter @kamiazya/whiteboard-mcp smoke:tarball",
    "smoke:codex-config": "pnpm --filter @kamiazya/whiteboard-mcp smoke:codex-config",
    "smoke:template": "pnpm --filter @kamiazya/whiteboard-mcp smoke:template",
    "smoke:claude": "pnpm --filter @kamiazya/whiteboard-mcp smoke:claude",
    "smoke:codex": "pnpm --filter @kamiazya/whiteboard-mcp smoke:codex",
    "smoke:all": "pnpm --filter @kamiazya/whiteboard-mcp smoke:all",
    "smoke:docker": "pnpm --filter @kamiazya/whiteboard-mcp smoke:docker",
    "smoke:docker-backup-restore": "pnpm --filter @kamiazya/whiteboard-mcp smoke:docker-backup-restore",
    "mutation:contracts": "pnpm --filter @kamiazya/whiteboard-mcp mutation:contracts",
    "publish:dry-run:npm": "pnpm --filter @kamiazya/whiteboard-mcp publish:dry-run:npm",
    "publish:dry-run:docker": "pnpm --filter @kamiazya/whiteboard-mcp publish:dry-run:docker",
    "publish:dry-run": "pnpm publish:dry-run:npm && pnpm publish:dry-run:docker",
    "publish:npm-provenance": "node --eval \"process.stderr.write('[publish:npm-provenance] not implemented: npm OIDC provenance runs in release.yml (CI-only, not locally runnable)\\n'); process.exit(1)\"",
    "publish:docker-sign": "node --eval \"process.stderr.write('[publish:docker-sign] not implemented: Docker keyless cosign runs in release.yml (CI-only, not locally runnable)\\n'); process.exit(1)\"",
    "test:e2e:distribution": "pnpm build && pnpm smoke:e2e && pnpm smoke:tarball && pnpm smoke:packaged && pnpm smoke:codex-config && pnpm smoke:template && pnpm smoke:claude && pnpm smoke:codex && pnpm --filter @kamiazya/whiteboard-mcp check:release-artifacts && node tests/e2e/distribution/packaged-daemon-backup-restore-smoke.mjs && node tests/e2e/distribution/packaged-daemon-logs-smoke.mjs && node tests/e2e/distribution/packaged-daemon-support-bundle-smoke.mjs && node tests/e2e/distribution/packaged-daemon-token-smoke.mjs && node tests/e2e/distribution/packaged-server-mode-app-smoke.mjs && node tests/e2e/distribution/packaged-server-mode-cli-smoke.mjs && node tests/e2e/distribution/packaged-server-mode-entrypoint-smoke.mjs",
    "check:release-candidate": "pnpm typecheck && pnpm build && pnpm --filter @kamiazya/whiteboard-mcp check:release-artifacts && pnpm --filter @kamiazya/whiteboard-mcp generate:sbom:npm && pnpm test && pnpm smoke:codex-config && pnpm test:e2e:distribution",
    "check:release-candidate:docker": "pnpm check:release-candidate && pnpm smoke:docker && pnpm smoke:docker-backup-restore",
    "check:release-candidate:local": "pnpm check:release-candidate && pnpm mutation:contracts",
    "check:pages-release": "pnpm --filter @whiteboard/checks pages-release",
    "intent:validate": "npx @tanstack/intent@latest validate",
    "intent:list": "npx @tanstack/intent@latest list",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:noconsole": "biome lint --only=lint/suspicious/noConsole --diagnostic-level=error packages/mcp-server/src/server",
    "secretlint": "secretlint --secretlintignore .secretlintignore \"**/*\"",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@secretlint/secretlint-rule-pattern": "13.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@tanstack/intent": "^0.0.40",
    "lefthook": "^2.1.9",
    "secretlint": "13.0.2",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "lodash-es@<4.18.0": "^4.18.0",
      "nanoid@<3.3.8": "^3.3.8",
      "nanoid@>=4.0.0 <5.0.9": "^5.0.9",
      "protobufjs@<8.6.0": "^8.6.0",
      "fast-uri@<3.1.2": "^3.1.2",
      "kysely@<0.28.17": "^0.28.17",
      "@grpc/grpc-js@<1.14.4": "^1.14.4",
      "shell-quote@<1.8.4": "^1.8.4",
      "uuid@<11.1.1": "^11.1.1",
      "qs@>=6.11.1 <6.15.2": "^6.15.2",
      "ip-address@<=10.1.0": "^10.1.1",
      "mermaid@<11.15.0": "^11.16.0",
      "dompurify@<3.4.11": "^3.4.11"
    }
  }
}

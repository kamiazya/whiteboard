# Server-mode image for whiteboard.
#
# Stages: base → fetched → build → runtime
#
#   base    — Node + pnpm via corepack
#   fetched — populate the pnpm store from the lockfile (cache-friendly)
#   build   — install deps, build widget + TypeScript, self-contained deploy
#   runtime — minimal image with the deploy bundle
#
# Runs `whiteboard server run --json` — the OAuth/JWT resource-server path.
# This image does NOT run the local daemon (`whiteboard daemon run`) and
# accepts no --token or WHITEBOARD_DAEMON_TOKEN; those belong to the
# local-daemon path only.
#
# TLS termination: the container binds plain HTTP on WHITEBOARD_SERVER_PORT
# (default 3099). Place a TLS-terminating reverse proxy (nginx, Caddy,
# Traefik, …) in front and set WHITEBOARD_SERVER_EXTERNAL_URL to the public
# HTTPS address. Never expose port 3099 directly to untrusted networks.
#
# Required runtime env (no defaults — fail-closed if missing):
#   WHITEBOARD_SERVER_EXTERNAL_URL     https://whiteboard.example.com
#   WHITEBOARD_SERVER_AUTH_STRATEGY    oauth-jwt
#   WHITEBOARD_SERVER_JWT_ISSUER       https://idp.example.com
#   WHITEBOARD_SERVER_JWT_AUDIENCE     https://whiteboard.example.com
#   WHITEBOARD_SERVER_JWKS_URI         https://idp.example.com/.well-known/jwks.json
#   WHITEBOARD_SERVER_ALLOWED_ORIGINS  https://whiteboard.example.com
#
# Persistent data: mount a volume at /data (WHITEBOARD_DATA_DIR default).
#
# NODE_VERSION: single source of truth is `.node-version`. Callers pass the
# value via --build-arg (no default — fails explicitly if unset).
#
# BASE IS DEBIAN (-slim), NOT ALPINE, and that is load-bearing. libsql ships
# prebuilt native bindings per libc; the musl one this image resolved
# (@libsql/linux-x64-musl@0.3.19, pulled transitively by
# @libsql/kysely-libsql -> @libsql/client@0.8.x) fails to load on the musl in
# current Alpine:
#
#     Error relocating .../@libsql/linux-x64-musl/index.node:
#     fcntl64: symbol not found     (ERR_DLOPEN_FAILED)
#
# The image built and could not start. It went unseen because nothing ran the
# container until the docker smokes were promoted to CI — the build-only
# dry-run said "green" about a proposition the runtime does not share.
# The glibc prebuild has no such gap. Moving back to Alpine means first
# checking that whatever libsql version the lockfile resolves has a musl
# prebuild that loads on that Alpine.


# ── base — common foundation ───────────────────────────────────────────────
ARG NODE_VERSION
FROM node:${NODE_VERSION}-slim AS base

# corepack reads the pnpm version from root package.json's packageManager
# field — no hardcoded version here.
ENV CI=true
RUN corepack enable
WORKDIR /workspace


# ── fetched — populate the pnpm store from the lockfile ────────────────────
FROM base AS fetched

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# patches/ travels WITH the lockfile, not with the sources copied later:
# pnpm-workspace.yaml's patchedDependencies makes the patch part of what
# `pnpm fetch` resolves, so a missing file here fails the fetch outright
# (ERR_PNPM_PATCH_NOT_FOUND) rather than silently shipping an unpatched
# dependency.
COPY patches ./patches

# The store lands in THIS LAYER, not in a `--mount=type=cache`. A cache
# mount's contents are never exported by a layer-cache backend and never
# restored with a cached layer, so `pnpm install --offline` below was correct
# only while this step kept running — and failed the first build where the
# layer cache worked (`fetched 3/3` CACHED, mount empty, install exit 1).
#
# On CI the mount could never have helped anyway: every job gets a fresh
# builder, so it started empty on every run. What it cost is the layer cache
# this stage exists to enable.
RUN pnpm fetch --store-dir /pnpm/store


# ── build — install + compile + deploy bundle ──────────────────────────────
FROM fetched AS build

# .dockerignore controls the context — adding a new workspace package
# needs no Dockerfile edit.
COPY . .

# GVS (enableGlobalVirtualStore) assumes a persistent global store that
# survives across installs; inside an ephemeral Docker build layer there
# is none, so symlinks into the store dangle. Disable it for the build.
# Reads the store out of the `fetched` layer above; see the note there for
# why it is not a cache mount.
RUN pnpm install --offline --frozen-lockfile \
      --store-dir /pnpm/store \
      --config.enable-global-virtual-store=false

RUN pnpm --filter @kamiazya/whiteboard-canvas-viewer build:widget
RUN pnpm --filter @kamiazya/whiteboard-mcp build

# Self-contained production bundle (no devDependencies, no workspace
# symlinks). --legacy is required by pnpm v10+ without
# inject-workspace-packages.
RUN pnpm --filter @kamiazya/whiteboard-mcp deploy --legacy /deploy


# ── runtime — final server image ──────────────────────────────────────────
FROM node:${NODE_VERSION}-slim AS runtime

RUN groupadd --system --gid 1001 whiteboard \
 && useradd  --system --uid 1001 --gid whiteboard --no-create-home whiteboard

WORKDIR /app

COPY --from=build /deploy .

RUN mkdir -p /data && chown whiteboard:whiteboard /data
VOLUME /data

ENV WHITEBOARD_DATA_DIR=/data \
    WHITEBOARD_SERVER_PORT=3099

EXPOSE 3099

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get({hostname:'127.0.0.1',port:+(process.env.WHITEBOARD_SERVER_PORT||3099),path:'/api/runtime/ping'},function(r){var d='';r.on('data',function(c){d+=c});r.on('end',function(){try{process.exit(JSON.parse(d).ok===true?0:1)}catch(e){process.exit(1)}})}).on('error',function(){process.exit(1)})"

USER whiteboard

ENTRYPOINT ["node", "dist/cli/index.js", "server", "run", "--json"]

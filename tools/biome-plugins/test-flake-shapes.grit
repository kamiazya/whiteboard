language js

// Executable half of three flake shapes from .claude/rules/integrator-flow.md,
// plus three shapes that are not flakes but fail the same way: the run reports
// green while checking less than it appears to.
// Guarded by .claude/scripts/biome-plugin.test.mjs, which reads the rules OUT
// OF THIS FILE and requires the bad fixture to reach each one.
// Adding a shape is the `executable-rungs` resource of the
// `testing-techniques` skill.
// Browser-only shapes live in browser-test-shapes.grit, which biome.json
// scopes to *.browser.test.*.
any {
  // A retried waitFor callback re-fires any action inside it, so the action
  // double-fires under load and the failure blames the assertion.
  `waitFor($cb)` where {
    $cb <: contains or { `fireEvent.$m($a)`, `userEvent.$m($a)`, `render($a)` },
    register_diagnostic(
      span = $cb,
      message = "Side effect inside waitFor: fire the event / render OUTSIDE the callback, assert inside. A retried callback re-fires the action (double-fired-action flake).",
      severity = "error"
    )
  },
  // The ninth flake shape: an afterEach wiping document.body leaves React
  // roots mounted on detached nodes; the NEXT test's reconciler throws
  // removeChild errors while every test in the file reports PASSED.
  // A wipe behind a named helper (afterEach(resetDom)) is past this rule's
  // floor — reader judgement in review covers that arrangement.
  `afterEach($cb)` where {
    $cb <: contains `document.body.innerHTML = $_`,
    register_diagnostic(
      span = $cb,
      message = "afterEach wipes document.body with innerHTML: React roots stay mounted on detached nodes and the NEXT test fails with removeChild errors. Unmount through testing-library cleanup() (or the mount API's own unmount).",
      severity = "error"
    )
  },
  // Fake timers left active leak into whatever the suite runs next unless
  // something restores them, and a retry or a neighbouring test then blames
  // the wrong code. A shared/global teardown that restores them project-wide
  // is a legitimate reason for a single file to carry none locally — say so
  // at the site rather than adding a per-file call that duplicates it.
  `vi.useFakeTimers()` where {
    not $program <: contains `vi.useRealTimers()`,
    register_diagnostic(
      span = $program,
      message = "vi.useFakeTimers() with no vi.useRealTimers() anywhere in this file: a leaked fake-timer state runs into whatever the suite executes next. Restore it (typically in afterEach), or say why a shared teardown already does.",
      severity = "error"
    )
  },
  // A focused test silently drops every OTHER test in its file. vitest
  // reports the survivors as skipped and exits 0, so CI is green over a file
  // that ran one case — the same "a smaller total reads like good news"
  // hazard AGENTS.md records for a mis-filtered `--project` run, in-file.
  //
  // Biome's own noFocusedTests is not enabled here (verified by linting a
  // fixture carrying `it.only` and getting no diagnostic), and nothing else
  // in the repo looks for it. Measured 0 occurrences when this was added, so
  // it costs nothing to keep out.
  `$runner.only($_, $_)` where {
    $runner <: or { `it`, `test`, `describe` },
    register_diagnostic(
      span = $runner,
      message = "A focused test drops every other test in this file and still exits 0 — CI goes green having run one case. Remove `.only` before committing.",
      severity = "error"
    )
  },
  // An async assertion nobody awaits checks nothing: the test ends before
  // the promise settles, and a rejection lands as an unhandled error (or
  // nowhere). Vitest 5 fails the test for this, so the lint rule is the same
  // verdict reached earlier — including in a file the runtime never reaches.
  // A `return` of the assertion is fine: the runner awaits a returned promise.
  // Measured 0 occurrences when this was added.
  `expect($x).$mode.$m($args)` as $call where {
    $mode <: or { `resolves`, `rejects` },
    not $call <: within `await $_`,
    not $call <: within `return $_`,
    register_diagnostic(
      span = $call,
      message = "Unawaited async assertion: `.resolves`/`.rejects` returns a promise, and without `await` the test finishes before it settles. Vitest 5 fails the test for this; `await` it (or `return` it).",
      severity = "error"
    )
  },
  `expect($x).toMatchFileSnapshot($args)` as $call where {
    not $call <: within `await $_`,
    not $call <: within `return $_`,
    register_diagnostic(
      span = $call,
      message = "Unawaited toMatchFileSnapshot: it reads and writes the snapshot file asynchronously, so an un-awaited call compares nothing. Vitest 5 fails the test for this; `await` it.",
      severity = "error"
    )
  },
  // A title is an identifier: flake-watch clusters failures by it, `-t`
  // filters on it, CI annotations carry it, and vitest 5 matches the whole
  // `suite > test` chain. A PR/issue number or a "pre-fix" in the title is
  // chronology (AGENTS.md's Source Comment Discipline, applied to titles) —
  // meaningless to the next reader and load-bearing for nothing. Name the
  // behaviour instead. Measured 3 occurrences when this was added, all
  // retitled in the same change.
  // Every group in the regex is `(?:...)`: a CAPTURING group is a pattern
  // variable to Biome's GritQL, and one here errored the WHOLE plugin
  // ("regex pattern matched 2 variables, but expected 0"), silencing every
  // other rule in this file. The fixture guard is what noticed.
  `$runner($title, $_)` where {
    $runner <: or { `it`, `test`, `describe` },
    $title <: r"(?s).*(?:\b(?:PR|CodeRabbit|CodeQL|Dependabot|issue|bug)\s*#?[0-9]+|\bpre-fix\b).*",
    register_diagnostic(
      span = $title,
      message = "Chronology in a test title (a PR/issue number, or 'pre-fix'): the title is an identifier that outlives the review, so name the behaviour under test instead.",
      severity = "error"
    )
  },
  `$runner.$mode($title, $_)` where {
    $runner <: or { `it`, `test`, `describe` },
    $mode <: or { `skip`, `only`, `concurrent` },
    $title <: r"(?s).*(?:\b(?:PR|CodeRabbit|CodeQL|Dependabot|issue|bug)\s*#?[0-9]+|\bpre-fix\b).*",
    register_diagnostic(
      span = $title,
      message = "Chronology in a test title (a PR/issue number, or 'pre-fix'): the title is an identifier that outlives the review, so name the behaviour under test instead.",
      severity = "error"
    )
  }
}

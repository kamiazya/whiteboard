language js

// Executable half of "a daemon route refuses in JSON", the rule the route
// fuzz lanes enforce at RUNTIME (a plain-text body is a failure there).
// Guarded by .claude/scripts/biome-plugin.test.mjs, which reads the rules OUT
// OF THIS FILE and requires the bad fixture to reach each one.
//
// `c.notFound()` is Hono's built-in 404 and answers `text/plain`. Every
// refusal under `/api/` in this daemon is a JSON object with an `error` code,
// so a caller parsing the body gets a SyntaxError instead of the reason —
// which is how a missing file came to answer plain text while every other
// refusal on the same router answered JSON (fixed in #1521, found by the
// fuzz lane rather than by a reader).
//
// SCOPED in biome.json to packages/mcp-server/src/server/routes/**, and it
// has to be: `c.notFound()` is CORRECT three times outside that directory,
// and a rule reaching them would flag working code.
//
//   - `app.ts`'s `/.well-known/oauth-protected-resource` pair answers a bare
//     404 by design (RFC 9728 discovery; the fuzz lane's ledger skips them
//     for the same reason).
//   - `app.ts`'s two UI catch-alls (`app.get('*')`) serve a browser, not an
//     API client, and a reserved UI path 404s with no body on purpose.
//
// What this rule deliberately does NOT ban, so the scope stays honest rather
// than exempted: `c.text` and `c.html` inside `routes/`. The OAuth approval
// page is HTML by design and its body-limit error is `c.text('Payload too
// large', 413)` on a browser-facing endpoint. Only the built-in 404 is
// unambiguous — nothing under `/api/` wants it.
//
// The receiver is not constrained: the Hono context is `c` at every site
// here, and keying on the name would buy nothing while missing a handler
// that spells it otherwise. Measured 0 non-Hono `.notFound()` calls in the
// scoped directory.

any {
  // Hono's built-in 404 answers text/plain.
  `$c.notFound()` where {
    register_diagnostic(
      span = $c,
      message = "c.notFound() answers text/plain, and every refusal under /api/ in this daemon is JSON: a caller parsing the body gets a SyntaxError instead of the reason. Answer c.json({ error: 'not_found', message }, 404) instead.",
      severity = "error"
    )
  },

  // An EXCEPTION's message in the slot a client switches on.
  //
  // `apiErrorBodySchema`'s code arm requires snake_case (`apiErrorCodeSchema`),
  // so `{ error: err.message }` is out of contract twice over: the code is a
  // sentence nobody can branch on, and with no `message` beside it
  // `apiErrorReason` answers `undefined` and every caller shows a generic
  // banner. Ten of server-core's nineteen refusals were this shape.
  //
  // GRIT rather than the source scan beside it
  // (`routes/error-body-shape.test.ts`), because that scan reads the `error`
  // value only when it is a STRING LITERAL — a member expression is invisible
  // to it, verified by putting one back and watching the scan stay green. The
  // runtime half (the fuzz lanes parsing every 4xx/5xx under the contract)
  // catches it only on a branch the fuzz happens to provoke. This is
  // syntactic, unambiguous and total over its scope.
  `$c.json({ error: $err.message }, $status)` where {
    register_diagnostic(
      span = $err,
      message = "An exception's message in the `error` slot is out of contract twice: the code is a sentence no client can switch on, and with no `message` beside it apiErrorReason answers undefined. Use errorBody('some_code', err.message).",
      severity = "error"
    )
  },

  // A validation failure's `issues` array, which the contract does not admit.
  //
  // `apiErrorBodySchema`'s code arm is `.strict()`, so a body carrying
  // `issues` fails to parse and `apiErrorReason` discards it WHOLE — the only
  // description of what was wrong, in the one field no reader looks at. Six
  // sites in mcp-server and nine in server-core answered this way.
  //
  // `{ $..., issues: $issues }`, not `{ $...rest, ... }`: the named-spread
  // form COMPILES and matches nothing. Measured against a file holding the
  // exact shape — a rule that loads clean and never fires, which is the
  // failure this plugin's fixture pair exists to make loud, and it did.
  `$c.json({ $..., issues: $issues }, $status)` where {
    register_diagnostic(
      span = $issues,
      message = "A raw `issues` array is outside the api error contract, whose code arm is strict: apiErrorReason discards the whole body and the caller shows a generic banner. Use invalidRequestBody(parsed.error), which flattens them into the reason.",
      severity = "error"
    )
  }
}

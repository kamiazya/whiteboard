{
  "name": "@kamiazya/whiteboard-mcp",
  "version": "0.0.19",
  "description": "MCP server + Excalidraw whiteboard UI for AI-assisted diagramming (Claude Code / Codex).",
  "author": "kamiazya",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "ai-tool",
    "cli",
    "npx",
    "tanstack-intent"
  ],
  "type": "module",
  "main": "./dist/server/mcp/index.js",
  "types": "./dist/server/mcp/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/mcp/index.d.ts",
      "import": "./dist/server/mcp/index.js"
    },
    "./browser-contract": {
      "types": "./src/shared/canvas-backend-contract.ts",
      "import": "./dist/shared/canvas-backend-contract.js"
    },
    "./browser-shared": {
      "types": "./src/shared/browser-shared-index.ts",
      "import": "./dist/shared/browser-shared-index.js"
    },
    "./daemon-backend": {
      "types": "./src/shared/daemon-backend.ts",
      "import": "./dist/shared/daemon-backend.js"
    },
    "./api-client": {
      "types": "./src/shared/api-client.ts",
      "import": "./dist/shared/api-client.js"
    },
    "./api-contracts": {
      "types": "./src/shared/api-contracts/index.ts",
      "import": "./dist/shared/api-contracts/index.js"
    },
    "./api-contracts-internal": {
      "types": "./src/shared/api-contracts/runtime.ts",
      "import": "./dist/shared/api-contracts/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "whiteboard": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/server/mcp/index.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/server/mcp/index.d.ts",
        "import": "./dist/server/mcp/index.js"
      },
      "./browser-contract": {
        "types": "./dist/shared/canvas-backend-contract.d.ts",
        "import": "./dist/shared/canvas-backend-contract.js"
      },
      "./browser-shared": {
        "types": "./dist/shared/browser-shared-index.d.ts",
        "import": "./dist/shared/browser-shared-index.js"
      },
      "./daemon-backend": {
        "types": "./dist/shared/daemon-backend.d.ts",
        "import": "./dist/shared/daemon-backend.js"
      },
      "./api-client": {
        "types": "./dist/shared/api-client.d.ts",
        "import": "./dist/shared/api-client.js"
      },
      "./api-contracts": {
        "types": "./dist/shared/api-contracts/index.d.ts",
        "import": "./dist/shared/api-contracts/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://github.com/kamiazya/whiteboard/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/kamiazya/whiteboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kamiazya/whiteboard.git",
    "directory": "packages/mcp-server"
  },
  "scripts": {
    "publish:dry-run:npm": "node scripts/release/publish-dry-run-npm.mjs",
    "publish:dry-run:docker": "node scripts/release/publish-dry-run-docker.mjs",
    "generate:sbom:npm": "node scripts/release/generate-npm-sbom.mjs",
    "smoke:docker": "node ../../tests/e2e/distribution/packaged-server-mode-docker-smoke.mjs",
    "smoke:docker-backup-restore": "node ../../tests/e2e/distribution/packaged-server-mode-backup-restore-smoke.mjs",
    "mutation:contracts": "stryker run",
    "mcp": "node --import tsx/esm src/server/mcp/index.ts",
    "mcp:http": "node dist/server/index.js --daemon --port=3099 --token=whiteboard-dev",
    "mcp:http:dev": "node scripts/dev/with-dev-data-dir.mjs --daemon --token=whiteboard-dev",
    "mcp:inspect": "npx @modelcontextprotocol/inspector",
    "mcp:inspect:stdio": "npx @modelcontextprotocol/inspector node --import tsx/esm src/server/mcp/index.ts",
    "mcp:debug:http": "concurrently \"pnpm mcp:http:dev\" \"pnpm mcp:inspect\"",
    "daemon": "node dist/server/index.js --daemon",
    "daemon:dev": "tsx watch src/server/index.ts --daemon",
    "build:server": "tsup && node scripts/prepend-cli-shebang.mjs && chmod +x dist/cli/index.js",
    "build": "pnpm build:server && node scripts/copy-widget-into-dist.mjs",
    "dev": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage --project mcp-node",
    "test:node": "vitest run --project mcp-node",
    "test:smoke": "vitest run --project mcp-smoke",
    "test:distribution:only": "vitest run --config vitest.distribution.config.ts",
    "test:distribution": "pnpm build && pnpm test:distribution:only",
    "test:watch": "vitest --project mcp-node",
    "check:pr-title": "node ../../tools/check-pr-title.mjs",
    "check:release-artifacts": "node scripts/release/check-release-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "smoke": "node scripts/smoke/mcp-smoke.mjs",
    "smoke:e2e": "node scripts/smoke/mcp-e2e-smoke.mjs",
    "smoke:packaged": "node scripts/smoke/mcp-e2e-smoke.mjs --entry=dist/server/mcp/index.js",
    "smoke:tarball": "node --import tsx/esm scripts/smoke/mcp-packed-tarball-smoke.mjs",
    "smoke:codex-config": "node --import tsx/esm scripts/smoke/mcp-codex-config-smoke.mjs",
    "smoke:template": "tsx scripts/smoke/mcp-template-smoke.mjs",
    "smoke:claude": "node scripts/smoke/mcp-claude-cli-smoke.mjs",
    "smoke:codex": "node scripts/smoke/mcp-codex-cli-smoke.mjs",
    "smoke:daemon-origin": "node --import tsx/esm scripts/smoke/mcp-daemon-origin-smoke.mjs",
    "smoke:lna-transport": "node scripts/smoke/mcp-lna-transport-smoke.mjs",
    "smoke:all": "pnpm smoke:e2e && pnpm smoke:template && pnpm smoke:claude",
    "prepublishOnly": "test -x dist/cli/index.js",
    "prepack": "node scripts/verify-web-app-dist.mjs && node scripts/verify-widget-dist.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/utils": "0.1.3-test32",
    "@hono/node-server": "^2.0.11",
    "@libsql/client": "^0.17.3",
    "@libsql/kysely-libsql": "^0.4.1",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "@napi-rs/canvas": "^0.1.100",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.8.0",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-fetch": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@resvg/resvg-js": "^2.6.2",
    "cosmiconfig": "^9.0.0",
    "happy-dom": "^20.9.0",
    "hono": "^4.12.27",
    "image-size": "^2",
    "inversify": "catalog:",
    "jose": "^6.2.3",
    "kysely": "^0.28.17",
    "loro-crdt": "catalog:",
    "nanoid": "^5.1.16",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "wawoff2": "^2.0.1",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@kamiazya/whiteboard-canvas-ports": "workspace:*",
    "@kamiazya/whiteboard-canvas-viewer": "workspace:*",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^9",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "libsql": "^0.5.29",
    "playwright": "^1.61.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

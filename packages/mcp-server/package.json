{
  "name": "@kamiazya/whiteboard-mcp",
  "version": "0.0.6",
  "description": "MCP server + Excalidraw whiteboard UI for AI-assisted diagramming (Claude Code / Codex).",
  "author": "kamiazya",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "excalidraw",
    "whiteboard",
    "diagram",
    "drawing",
    "ai-tool",
    "cli",
    "npx",
    "tanstack-intent"
  ],
  "type": "module",
  "main": "./dist/server/mcp/index.js",
  "types": "./dist/server/mcp/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/mcp/index.d.ts",
      "import": "./dist/server/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "whiteboard-mcp": "dist/server/mcp/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/server/mcp/index.js",
    "./dist/app/**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "homepage": "https://github.com/kamiazya/whiteboard/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/kamiazya/whiteboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kamiazya/whiteboard.git",
    "directory": "packages/mcp-server"
  },
  "scripts": {
    "mcp": "node --import tsx/esm src/server/mcp/index.ts",
    "mcp:http": "node dist/server/index.js --daemon --port=3099 --token=whiteboard-dev",
    "mcp:http:dev": "tsx watch src/server/index.ts --daemon --port=3099 --token=whiteboard-dev",
    "mcp:inspect": "npx @modelcontextprotocol/inspector",
    "mcp:inspect:stdio": "npx @modelcontextprotocol/inspector node --import tsx/esm src/server/mcp/index.ts",
    "mcp:debug:http": "concurrently \"pnpm mcp:http:dev\" \"pnpm mcp:inspect\"",
    "daemon": "node dist/server/index.js --daemon",
    "daemon:dev": "tsx watch src/server/index.ts --daemon",
    "build:server": "tsc -p tsconfig.server.json && chmod +x dist/server/mcp/index.js",
    "build:app": "vite build",
    "build": "pnpm build:server && pnpm build:app",
    "dev": "concurrently \"vite\" \"tsx watch src/server/index.ts\"",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage --project mcp-node --project mcp-jsdom",
    "test:node": "vitest run --project mcp-node --project mcp-jsdom",
    "test:browser": "vitest run --project mcp-browser",
    "test:browser:trace": "vitest run --project mcp-browser --browser.trace=on",
    "docs:snapshots": "vitest run --config vitest.docs-snapshots.config.ts",
    "docs:snapshots:check": "pnpm docs:snapshots && pnpm docs:snapshots && git diff --exit-code -- ../../docs/assets/",
    "test:watch": "vitest --project mcp-node --project mcp-jsdom",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "smoke": "node scripts/mcp-smoke.mjs",
    "smoke:e2e": "node scripts/mcp-e2e-smoke.mjs",
    "smoke:packaged": "node scripts/mcp-e2e-smoke.mjs --entry=dist/server/mcp/index.js",
    "smoke:tarball": "node scripts/mcp-packed-tarball-smoke.mjs",
    "smoke:codex-config": "node scripts/mcp-codex-config-smoke.mjs",
    "smoke:template": "tsx scripts/mcp-template-smoke.mjs",
    "smoke:claude": "node scripts/mcp-claude-cli-smoke.mjs",
    "smoke:codex": "node scripts/mcp-codex-cli-smoke.mjs",
    "smoke:all": "pnpm smoke:e2e && pnpm smoke:template && pnpm smoke:claude",
    "prepublishOnly": "test -x dist/server/mcp/index.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/utils": "0.1.3-test32",
    "@hono/node-server": "^2.0.0",
    "@libsql/client": "^0.17.3",
    "@libsql/kysely-libsql": "^0.4.1",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "@napi-rs/canvas": "^0.1.100",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/instrumentation": "^0.216.0",
    "@opentelemetry/instrumentation-fetch": "^0.216.0",
    "@opentelemetry/instrumentation-pino": "^0.62.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@resvg/resvg-js": "^2.6.2",
    "happy-dom": "^20.9.0",
    "hono": "^4.12.15",
    "image-size": "^2",
    "kysely": "^0.28.16",
    "loro-crdt": "^1.11.1",
    "nanoid": "^5.1.9",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "wawoff2": "^2.0.1",
    "ws": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/intent": "^0.0.40",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9",
    "jsdom": "^29.0.2",
    "libsql": "^0.5.29",
    "lucide-react": "^1.11.0",
    "playwright": "^1.59.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-top-level-await": "^1",
    "vite-plugin-wasm": "^3",
    "vitest": "^4.1.5"
  }
}

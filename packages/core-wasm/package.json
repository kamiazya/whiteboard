{
  "name": "@kamiazya/whiteboard-core-wasm",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "The Rust core's wasm artifact behind a thin TypeScript shim (ADR-0054): init from bytes or a compiled module the composition root hands it, an ABI check, and one typed call per user operation. No node:*, so it loads the same in Node, a browser and a worker.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#glue": "./artifacts/whiteboard_wasm.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:abi": "tsc --noEmit -p tsconfig.abi.json",
    "test": "vitest run",
    "stage:wasm": "node scripts/stage-artifacts.mjs",
    "build:wasm": "pnpm -w rust:build:wasm && node scripts/stage-artifacts.mjs"
  },
  "dependencies": {
    "@kamiazya/whiteboard-model": "workspace:*",
    "@kamiazya/whiteboard-scene": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@kamiazya/whiteboard-plugin-visual",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "The bundled `visual` facet plugin, as an ordinary plugin package: its data half (schemas, resolvers, the icon vocabulary `visual.symbol` enumerates) and its React half, shipped side by side. Never published to npm.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./emoji": {
      "types": "./src/emoji/index.ts",
      "import": "./src/emoji/index.ts"
    },
    "./emoji/search": {
      "types": "./src/emoji/search.ts",
      "import": "./src/emoji/search.ts"
    },
    "./emoji/shortcode": {
      "types": "./src/emoji/shortcode.ts",
      "import": "./src/emoji/shortcode.ts"
    },
    "./package.json": "./package.json",
    "./render": {
      "types": "./src/render.ts",
      "import": "./src/render.ts"
    },
    "./ui": {
      "types": "./src/ui.tsx",
      "import": "./src/ui.tsx"
    },
    "./emoji/searchable": {
      "types": "./src/emoji/searchable.ts",
      "import": "./src/emoji/searchable.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.node.config.ts && vitest run --config vitest.jsdom.config.ts"
  },
  "dependencies": {
    "@kamiazya/whiteboard-facet-engine": "workspace:*",
    "@kamiazya/whiteboard-facet-ui": "workspace:*",
    "@kamiazya/whiteboard-model": "workspace:*",
    "@kamiazya/whiteboard-scene": "workspace:*",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.7.0",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

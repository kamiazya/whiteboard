{
  "name": "@kamiazya/whiteboard-canvas-render",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Spatial-canvas scene graph, pure layout, SVG backend, and sceneDigest — shared-layer, runs unchanged on Node/browser/Workers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./canvas-view-picture": {
      "types": "./src/picture/canvas-view-picture.ts",
      "import": "./src/picture/canvas-view-picture.ts"
    },
    "./scoring": {
      "types": "./src/scoring.ts",
      "import": "./src/scoring.ts"
    },
    "./test-utils": {
      "types": "./src/test-utils/index.ts",
      "import": "./src/test-utils/index.ts"
    },
    "./test-utils/browser-core": {
      "types": "./src/test-utils/browser-layout-core.ts",
      "import": "./src/test-utils/browser-layout-core.ts"
    },
    "./test-utils/node-core": {
      "types": "./src/test-utils/test-layout-core.ts",
      "import": "./src/test-utils/test-layout-core.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutation:render": "stryker run"
  },
  "dependencies": {
    "@kamiazya/whiteboard-codec": "workspace:*",
    "@kamiazya/whiteboard-facet-engine": "workspace:*",
    "@kamiazya/whiteboard-model": "workspace:*",
    "@kamiazya/whiteboard-plugin-visual": "workspace:*",
    "@kamiazya/whiteboard-scene": "workspace:*",
    "highlight.js": "catalog:",
    "lowlight": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@kamiazya/whiteboard-core-wasm": "workspace:*",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "fast-check": "^4.10.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@kamiazya/whiteboard-server-core",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Server core: /api/v1 Hono routes and MCP tool definitions, exposed as createServer(deps).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts"
    },
    "./search-query": {
      "types": "./src/search-query.ts",
      "import": "./src/search-query.ts"
    },
    "./api-errors": {
      "types": "./src/api-errors.ts",
      "import": "./src/api-errors.ts"
    },
    "./versions/version-entry": {
      "types": "./src/versions/version-entry.ts",
      "import": "./src/versions/version-entry.ts"
    },
    "./test-utils/fake-version-history": {
      "types": "./src/test-utils/fake-version-history.ts",
      "import": "./src/test-utils/fake-version-history.ts"
    },
    "./test-utils/embedder-contract": {
      "types": "./src/test-utils/embedder-contract.ts",
      "import": "./src/test-utils/embedder-contract.ts"
    },
    "./log-levels": {
      "types": "./src/log-levels.ts",
      "import": "./src/log-levels.ts"
    },
    "./viewport-request": {
      "types": "./src/viewport-request.ts",
      "import": "./src/viewport-request.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.node.config.ts"
  },
  "dependencies": {
    "@kamiazya/whiteboard-canvas-render": "workspace:*",
    "@kamiazya/whiteboard-codec": "workspace:*",
    "@kamiazya/whiteboard-facet-engine": "workspace:*",
    "@kamiazya/whiteboard-loro-adapter": "workspace:*",
    "@kamiazya/whiteboard-model": "workspace:*",
    "@kamiazya/whiteboard-plugin-visual": "workspace:*",
    "@kamiazya/whiteboard-ports": "workspace:*",
    "@kamiazya/whiteboard-reference-graph": "workspace:*",
    "@kamiazya/whiteboard-search": "workspace:*",
    "hono": "^4.13.9",
    "loro-crdt": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

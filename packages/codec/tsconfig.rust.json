{
  // The tests that install the core import core-wasm, whose glue is typed against the DOM lib's
  // WebAssembly and BufferSource; the package's own config keeps that lib out. The vitest config
  // is here because importing it is what brings @types/node into this program, which the
  // installer's node:fs needs.
  "extends": "./tsconfig.json",
  "compilerOptions": { "lib": ["ES2022", "ES2024.String", "DOM"] },
  "include": [
    "src/test-utils/core-setup",
    "src/okf/okf-core.test.ts",
    "src/spatial/spatial-core.test.ts",
    "vitest.node.config.ts"
  ],
  "exclude": []
}

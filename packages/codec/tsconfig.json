{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src", "vitest.node.config.ts"],
  "exclude": [
    "src/test-utils/core-setup",
    "src/okf/okf-core.test.ts",
    "src/spatial/spatial-core.test.ts"
  ]
}

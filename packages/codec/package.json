{
  "name": "@kamiazya/whiteboard-codec",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Single-document codec: OKF-Markdown and JSON Canvas parse/serialize through the Rust core, and the reference grammar's scanner, writer and rewrite. Shared layer — no node:*, DOM, inversify, or loro-crdt.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./okf-schema": {
      "types": "./src/okf/schema.ts",
      "import": "./src/okf/schema.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.rust.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamiazya/whiteboard-model": "workspace:*",
    "zod": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@kamiazya/whiteboard-core-wasm": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@kamiazya/whiteboard-history",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "A document's history as pure mechanics over the workspace record: the checkpoint scheduler, version retention and frontier encoding. Shared by both keepers, because what differs between them is where the rows live, never what a checkpoint is.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./checkpoint-scheduler": {
      "types": "./src/checkpoints/scheduler.ts",
      "import": "./src/checkpoints/scheduler.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamiazya/whiteboard-model": "workspace:*",
    "loro-crdt": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

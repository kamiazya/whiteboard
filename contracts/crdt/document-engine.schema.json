{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRDT document engine",
  "description": "The wire of the CRDT document engine: open, import, export, write, read, undo, redo and a text splice over a handle. No callback crosses it; the TypeScript and the Rust engine both implement it.",
  "x-wb-emit": {
    "zod": "packages/model/src/generated/crdt.zod.ts",
    "rust": "crates/core/model/src/generated/crdt.rs"
  },
  "x-wb-describe": false,
  "x-wb-rustSerde": false,
  "x-wb-readonlyTypes": false,
  "$defs": {
    "Bytes": {
      "description": "Bytes on the wire: base64 with padding, as the recorded oracles hold them.",
      "type": "string"
    },
    "PeerId": {
      "description": "A Loro peer id: the unsigned 64-bit number in decimal.",
      "type": "string"
    },
    "DocumentId": {
      "description": "A document id: the workspace tree node hosting it.",
      "type": "string"
    },
    "Handle": {
      "description": "What open answers: an engine-held document, never reused in an engine life.",
      "type": "integer"
    },
    "ExportMode": {
      "description": "What an export carries: all of it, the operations since a version, or a shallow state.",
      "type": "string",
      "enum": ["snapshot", "update", "shallow-snapshot"]
    },
    "WriterName": {
      "description": "A write by name: one per writer of the recorded write oracle.",
      "type": "string",
      "enum": [
        "writeSpatialCanvas",
        "writeSpatialNode",
        "writeSpatialEdge",
        "deleteSpatialNode",
        "deleteSpatialEdge",
        "reconcileSpatialCanvas",
        "setNodeLock",
        "setEdgeLock",
        "withSpatialBatch",
        "writeMarkdownBody",
        "writeDocumentKind",
        "writeFacets",
        "writeCoreFacets",
        "writeTrustFacets",
        "reconcileFacets",
        "reconcileCoreFacets",
        "writeCanvasFacetsField",
        "writeCommentThread",
        "writeThreadMessage",
        "setCommentThreadStatus",
        "moveCommentThread",
        "markThreadPassages",
        "writeProposal",
        "setProposedChangeStatus",
        "withDocumentBatch",
        "reconcileDocContent",
        "writeWorkspaceDocumentContent",
        "writeDocumentContentAndName",
        "seedNameFromTitle",
        "seedNamesFromTitles",
        "stampEditedDocuments",
        "createWorkspaceDocumentAtPath",
        "createWorkspaceDocument",
        "ensureFolderPath",
        "moveWorkspaceDocument",
        "moveWorkspaceNodeToPath",
        "setWorkspaceDocumentName",
        "setWorkspaceFolderName",
        "deleteWorkspaceDocument",
        "deleteWorkspaceNode",
        "deleteWorkspaceNodeAtPath",
        "setWorkspaceLastCompactedAt",
        "setWorkspacePinned",
        "updateWorkspaceDocumentMeta",
        "pruneEmptyFolders",
        "recordTrashEntry",
        "duplicateWorkspaceDocument",
        "minimalChange"
      ]
    },
    "QueryName": {
      "description": "A read by name: one per reader of the recorded read oracle.",
      "type": "string",
      "enum": [
        "documentKind",
        "documentContent",
        "spatialCanvas",
        "nodeLocks",
        "edgeLocks",
        "spatialNodeCount",
        "markdownBody",
        "bodyDelta",
        "coreFacets",
        "trustFacets",
        "facets",
        "annotations",
        "commentThreads",
        "threadMarks",
        "proposals",
        "imageRefIds",
        "retiredStoredShape",
        "stateSize",
        "contentDigest",
        "textLimitBreach",
        "documents",
        "nodes",
        "meta",
        "pinned",
        "trash",
        "folderNames",
        "unreadableNodes",
        "removedSince",
        "touchedSince",
        "organisationChangedSince",
        "fileReferences",
        "workspaceDocumentEntry",
        "workspaceDocumentProjection"
      ]
    },
    "BreachShape": {
      "description": "Which limit a refused update broke, as the sync judges name it.",
      "type": "string",
      "enum": [
        "run",
        "runs",
        "body",
        "node-text",
        "node-location",
        "label",
        "comment-message",
        "tags",
        "container-name",
        "canvas-size",
        "thread-anchor",
        "anchor-quote",
        "open-threads",
        "open-changes",
        "thread-messages",
        "content-root",
        "reserved-map-key",
        "retired-shape",
        "retired-comment-plane",
        "unattached-container"
      ]
    },
    "VersionEntry": {
      "description": "One peer in a version or a frontier: the peer and a counter.",
      "type": "object",
      "properties": {
        "peer": {
          "$ref": "#/$defs/PeerId",
          "description": "The peer."
        },
        "counter": {
          "type": "integer",
          "description": "The operation counter."
        }
      },
      "required": ["peer", "counter"],
      "x-wb-order": ["peer", "counter"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "Breach": {
      "description": "The refusal of an update that breaks a text or structure limit.",
      "type": "object",
      "properties": {
        "shape": {
          "$ref": "#/$defs/BreachShape",
          "description": "The limit broken."
        },
        "container": {
          "type": "string",
          "description": "The container that broke it, when the limit names one."
        }
      },
      "required": ["shape"],
      "x-wb-order": ["shape", "container"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "Write": {
      "description": "One write: the writer and its arguments, any-value on purpose.",
      "type": "object",
      "properties": {
        "op": {
          "$ref": "#/$defs/WriterName",
          "description": "The writer."
        },
        "args": {
          "x-wb-any": true,
          "description": "The writer arguments, a JSON object."
        }
      },
      "required": ["op", "args"],
      "x-wb-order": ["op", "args"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "Query": {
      "description": "One read: the reader and its arguments, any-value on purpose.",
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/QueryName",
          "description": "The reader."
        },
        "args": {
          "x-wb-any": true,
          "description": "The reader arguments, a JSON object; omitted when it takes none."
        }
      },
      "required": ["query"],
      "x-wb-order": ["query", "args"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "OpenRequest": {
      "description": "Open a document: from bytes an engine exported, or empty.",
      "type": "object",
      "properties": {
        "peer": {
          "$ref": "#/$defs/PeerId",
          "description": "The peer id this replica writes as."
        },
        "bytes": {
          "$ref": "#/$defs/Bytes",
          "description": "The document to open; empty when absent."
        }
      },
      "required": ["peer"],
      "x-wb-order": ["peer", "bytes"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "OpenResponse": {
      "description": "The document opened.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The handle every later call names."
        }
      },
      "required": ["handle"],
      "x-wb-order": ["handle"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "ImportRequest": {
      "description": "Merge exported bytes into an open document.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        },
        "bytes": {
          "$ref": "#/$defs/Bytes",
          "description": "A snapshot, update or shallow snapshot."
        }
      },
      "required": ["handle", "bytes"],
      "x-wb-order": ["handle", "bytes"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "ExportRequest": {
      "description": "Export an open document.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        },
        "mode": {
          "$ref": "#/$defs/ExportMode",
          "description": "What to export."
        },
        "from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionEntry"
          },
          "description": "For an update: the version the receiver already holds. Absent exports everything."
        },
        "frontiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VersionEntry"
          },
          "description": "For a shallow snapshot: the frontier it keeps the state at."
        }
      },
      "required": ["handle", "mode"],
      "x-wb-order": ["handle", "mode", "from", "frontiers"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "ExportResponse": {
      "description": "What an export produced.",
      "type": "object",
      "properties": {
        "bytes": {
          "$ref": "#/$defs/Bytes",
          "description": "The exported bytes."
        }
      },
      "required": ["bytes"],
      "x-wb-order": ["bytes"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "WriteRequest": {
      "description": "Apply writes to an open document as one batch.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        },
        "batch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Write"
          },
          "description": "The writes, applied in order."
        }
      },
      "required": ["handle", "batch"],
      "x-wb-order": ["handle", "batch"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "ReadRequest": {
      "description": "Ask an open document a question.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        },
        "query": {
          "$ref": "#/$defs/Query",
          "description": "The read."
        }
      },
      "required": ["handle", "query"],
      "x-wb-order": ["handle", "query"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "ReadResponse": {
      "description": "What a read answered, as the recorded oracle writes it.",
      "type": "object",
      "properties": {
        "value": {
          "x-wb-any": true,
          "description": "The answer, plain JSON."
        }
      },
      "required": ["value"],
      "x-wb-order": ["value"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "UndoRequest": {
      "description": "Undo the last local change of an open document.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        }
      },
      "required": ["handle"],
      "x-wb-order": ["handle"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "RedoRequest": {
      "description": "Redo the last undone local change of an open document.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        }
      },
      "required": ["handle"],
      "x-wb-order": ["handle"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "TextSpliceRequest": {
      "description": "Replace a run of a text container, in UTF-16 code units.",
      "type": "object",
      "properties": {
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "The document."
        },
        "documentId": {
          "$ref": "#/$defs/DocumentId",
          "description": "The hosting tree node; absent for a document that is its own root."
        },
        "text": {
          "type": "string",
          "description": "The text container key in the document."
        },
        "index": {
          "type": "integer",
          "description": "Where the run starts, in UTF-16 code units."
        },
        "remove": {
          "type": "integer",
          "description": "How many UTF-16 code units to remove."
        },
        "insert": {
          "type": "string",
          "description": "The text to insert."
        }
      },
      "required": ["handle", "text", "index", "remove", "insert"],
      "x-wb-order": ["handle", "documentId", "text", "index", "remove", "insert"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    },
    "MutationResult": {
      "description": "What a call that changes a document answers: what changed, the update, a refusal.",
      "type": "object",
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentId"
          },
          "description": "The documents the call changed."
        },
        "localUpdate": {
          "$ref": "#/$defs/Bytes",
          "description": "The update that carries the change; absent when nothing changed."
        },
        "breach": {
          "$ref": "#/$defs/Breach",
          "description": "Set when the call was refused; nothing changed then."
        }
      },
      "required": ["changed"],
      "x-wb-order": ["changed", "localUpdate", "breach"],
      "additionalProperties": false,
      "x-wb-unknownKeys": "refuse"
    }
  }
}

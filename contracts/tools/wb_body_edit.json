{
  "name": "wb_body_edit",
  "description": "Replace passages of a markdown document's body. Each op quotes the passage it means and declares what that passage said when the edit was written, so a passage that has since moved is still found and one that has since changed is refused by name rather than overwritten. Passages are stored as a PROPOSAL for a person to adopt or dismiss rather than changing the document — that is the default, since nobody watches an agent type; `mode: \"apply\"` changes the body directly, which is what a surface a person is looking at passes. `proposalId` keeps several calls in one proposal. Either every passage in a call is accepted or none is.",
  "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "workspaceId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9-]+(\\/[a-zA-Z0-9-]+)?$",
        "description": "Workspace id, <handle>/<segment>, or a segment of your own."
      },
      "documentId": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
      },
      "mode": {
        "type": "string",
        "enum": ["apply", "propose"]
      },
      "proposalId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "author": {
        "description": "Who is proposing, e.g. \"claude-code/1.0\". Set when this call opens the proposal; a call continuing one (proposalId) keeps its existing author.",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "ops": {
        "minItems": 1,
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Your id for this change; any short unique string."
            },
            "op": {
              "type": "string",
              "const": "body.replace"
            },
            "anchor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "text"
                },
                "nodeId": {
                  "description": "The text node the passage is in; omit for a markdown document's own body.",
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "description": "Text just before the passage, to tell it from a repeat.",
                      "type": "string",
                      "maxLength": 32
                    },
                    "exact": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "description": "The passage, quoted exactly as the body has it."
                    },
                    "suffix": {
                      "description": "Text just after the passage, to tell it from a repeat.",
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "required": ["exact"],
                  "additionalProperties": false,
                  "description": "What the passage says; this is what finds it if the text has moved."
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Character offset where the passage starts in the body (or node text) as you read it."
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Character offset just past the end of the passage."
                }
              },
              "required": ["kind", "quote", "start", "end"],
              "additionalProperties": false,
              "description": "Which passage to replace."
            },
            "text": {
              "type": "string",
              "description": "What the passage becomes; empty deletes it."
            },
            "assumed": {
              "type": "string",
              "maxLength": 262144,
              "description": "What the passage said when you wrote this; refused by name if it has changed since."
            }
          },
          "required": ["id", "op", "anchor", "text", "assumed"],
          "additionalProperties": false
        }
      }
    },
    "required": ["workspaceId", "documentId", "ops"],
    "additionalProperties": false
  },
  "annotations": {
    "destructiveHint": false,
    "openWorldHint": false,
    "title": "Replace passages of a document's body"
  },

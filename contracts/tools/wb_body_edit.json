                              "description": "Text just after the passage, to tell it from a repeat.",
                              "type": "string"
                            }
                          },
                          "required": ["exact"],
                          "additionalProperties": false,
                          "description": "What the passage says; this is what finds it if the text has moved."
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Character offset where the passage starts in the body (or node text) as you read it."
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Character offset just past the end of the passage."
                        }
                      },
                      "required": ["kind", "quote", "start", "end"],
                      "additionalProperties": false,
                      "description": "Which passage to replace."
                    },
                    "text": {
                      "type": "string",
                      "description": "What the passage becomes; empty deletes it."
                    },
                    "assumed": {
                      "type": "string",
                      "description": "What the passage said when you wrote this; refused by name if it has changed since."
                    }
                  },
                  "required": ["id", "status", "op", "anchor", "text", "assumed"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["id", "changes"],
        "additionalProperties": false
      },
      "body": {
        "type": "string"
      }
    },
    "required": ["documentId", "applied", "body"],
    "additionalProperties": false,
    "$defs": {
      "CanvasColor": {
        "anyOf": [
          {
            "type": "string",
            "enum": ["1", "2", "3", "4", "5", "6"]
          },
          {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        ]
      },
      "NodeEmbed": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          "versionRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["documentId"],
        "additionalProperties": false
      },
      "ExtensionFacets": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "EdgeEnd": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1,
            "description": "The node this end attaches to."
          },
          "side": {
            "description": "The side of the node to attach to. Omit it: the router picks the side that keeps the line clear of other boxes, and a named side is kept even through one.",
            "type": "string",
            "enum": ["top", "right", "bottom", "left"]
          },
          "end": {
            "description": "The arrowhead drawn at this end.",
            "type": "string",
            "enum": ["none", "arrow"]
          }
        },
        "required": ["node"],
        "additionalProperties": false
      },
      "Bends": {
        "minItems": 1,
        "maxItems": 64,
        "type": "array",
        "items": {
          "$ref": "#/$defs/CanvasPoint"
        }
      },
      "CanvasPoint": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      },
      "LineEnd": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "node"
              },
              "node": {
                "type": "string",
                "minLength": 1,
                "description": "The node this end attaches to."
              },
              "side": {
                "description": "The side of the node to attach to. Omit it: the router picks the side that keeps the line clear of other boxes, and a named side is kept even through one.",
                "type": "string",
                "enum": ["top", "right", "bottom", "left"]
              },
              "end": {
                "description": "The arrowhead drawn at this end.",
                "type": "string",
                "enum": ["none", "arrow"]
              }
            },
            "required": ["kind", "node"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "point"
              },
              "point": {
                "description": "Where this end sits, in canvas coordinates.",
                "$ref": "#/$defs/CanvasPoint"
              },
              "end": {
                "description": "The arrowhead drawn at this end.",
                "type": "string",
                "enum": ["none", "arrow"]
              }
            },
            "required": ["kind", "point"],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}

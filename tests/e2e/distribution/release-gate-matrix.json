    {
      "id": "publish:dry-run:npm",
      "command": "pnpm publish:dry-run:npm",
      "category": "publish",
      "requiredFor": ["publish-dry-run"],
      "requiresDocker": false,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "medium",
      "prCoverage": {
        "kind": "workflow-step",
        "workflow": "ci.yml",
        "jobId": "dry-run-npm",
        "stepName": "npm publish dry-run"
      }
    },
    {
      "id": "publish:dry-run:docker",
      "command": "pnpm publish:dry-run:docker",
      "category": "docker",
      "requiredFor": ["publish-dry-run"],
      "requiresDocker": true,
      "requiresNetwork": true,
      "expectedRuntimeBucket": "slow",
      "prCoverage": {
        "kind": "conditional-workflow-step",
        "workflow": "ci.yml",
        "jobId": "dry-run-docker",
        "stepName": "Docker build dry-run",
        "condition": "steps.detect.outputs.docker == 'true'",
        "conditionReason": "the step answers only whether Dockerfile.server still builds, so a pull request that changes nothing the image compiles cannot change its answer. The affecting set is derived, not listed: tools/checks/src/docker-build-inputs.mjs walks the workspace closure of the pnpm --filter targets read out of Dockerfile.server, and adds every manifest, patches/ and all root-level files. It fails open on any error resolving the diff, and pushes to main and merge_group runs pass 'always' so the last commit before a release tag is never skipped."
      }
    }
  ]
}

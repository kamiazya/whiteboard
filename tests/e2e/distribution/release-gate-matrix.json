    {
      "id": "smoke:docker",
      "command": "pnpm smoke:docker",
      "category": "docker",
      "requiredFor": ["docker-release"],
      "requiresDocker": true,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "slow",
      "prCoverage": {
        "kind": "conditional-workflow-step",
        "workflow": "ci.yml",
        "jobId": "dry-run-docker",
        "stepName": "Server-mode docker smoke",
        "condition": "steps.detect.outputs.docker == 'true'",
        "conditionReason": "the scenarios run against the image publish:dry-run:docker just built in the same job (WHITEBOARD_SMOKE_IMAGE), so they are gated by the same derived answer: a pull request that changes nothing the image compiles produces the same container, and there is no image for the scenarios to run against without paying for the build. Pushes to main and merge_group runs are never skipped."
      }
    },
    {
      "id": "smoke:docker-backup-restore",
      "command": "pnpm smoke:docker-backup-restore",
      "category": "docker",
      "requiredFor": ["docker-release"],
      "requiresDocker": true,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "slow",
      "prCoverage": {
        "kind": "exception",
        "reason": "the smoke cannot pass as written, found by running it: scenario 3 saves a workspace palette via PUT /api/workspaces/:ws/palette, and no route registers /palette anywhere in the server \u2014 the endpoint is gone. Its remaining scenarios are unverified against the current API for the same reason, since running only on the release path meant none of them had ever executed. A separate defect it also surfaced IS fixed here: dist/server/server-mode-backup-restore.js was not a tsup entry, so no build produced the module the smoke imports. Restoring PR coverage needs the smoke rewritten against the current API, which is its own change; smoke:docker (ten scenarios) does run on every affecting pull request"
      }
    },
    {
      "id": "mutation:contracts",
      "command": "pnpm mutation:contracts",
      "category": "mutation",
      "requiredFor": ["local-release"],

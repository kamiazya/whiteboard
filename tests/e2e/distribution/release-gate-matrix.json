      "requiresDocker": false,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "fast",
      "prCoverage": {
        "kind": "aggregate",
        "workflow": "ci.yml",
        "jobId": "test-unit",
        "expectedCommandSubstrings": ["vitest run"]
      }
    },

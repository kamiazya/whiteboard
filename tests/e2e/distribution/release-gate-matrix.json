    {
      "id": "smoke:docker",
      "command": "pnpm smoke:docker",
      "category": "docker",
      "requiredFor": ["docker-release"],
      "requiresDocker": true,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "slow",
      "prCoverage": {
        "kind": "exception",
        "reason": "requires docker daemon + multi-minute image builds. The PR-side docker path is gate publish:dry-run:docker, which BUILDS the image and never runs a container, so none of this gate's runtime scenarios are exercised on a pull request"
      }
    },
    {
      "id": "smoke:docker-backup-restore",
      "command": "pnpm smoke:docker-backup-restore",
      "category": "docker",
      "requiredFor": ["docker-release"],
      "requiresDocker": true,
      "requiresNetwork": false,
      "expectedRuntimeBucket": "slow",
      "prCoverage": {
        "kind": "exception",
        "reason": "requires docker daemon + multi-minute image builds. The PR-side docker path is gate publish:dry-run:docker, which BUILDS the image and never runs a container, so the backup/restore round trip is exercised only on the docker-release path"
      }
    },

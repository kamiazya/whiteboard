# Server-mode environment variables example.
# Copy to .env and fill in your values before running:
#   cp .env.server.example .env
#   NODE_VERSION="$(cat .node-version)" docker compose -f docker-compose.server.yml up -d --build
#
# The five uncommented WHITEBOARD_SERVER_* vars are required for production
# auth; the commented ones further down are optional.
# Do NOT bake these into the Docker image; supply them at run time.

# Public URL where whiteboard is reachable (must be https:// in production).
WHITEBOARD_SERVER_EXTERNAL_URL=https://whiteboard.example.com

# Auth strategy. Supported: oauth-jwt
WHITEBOARD_SERVER_AUTH_STRATEGY=oauth-jwt

# OAuth / OIDC issuer URL (must match iss claim in JWTs).
WHITEBOARD_SERVER_JWT_ISSUER=https://auth.example.com

# Expected aud claim in JWTs.
WHITEBOARD_SERVER_JWT_AUDIENCE=whiteboard

# JWKS endpoint served by your identity provider (https://, no credentials, no query params).
WHITEBOARD_SERVER_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# --- Optional; every value below is the default unless noted. ---

# Comma-separated list of allowed origins for CORS: exact https:// origins, or a
# https://*.example.com leftmost-label wildcard subdomain pattern per entry (bare * is rejected).
# Defaults to WHITEBOARD_SERVER_EXTERNAL_URL when unset; set it only to allow more.
# WHITEBOARD_SERVER_ALLOWED_ORIGINS=https://whiteboard.example.com

# Address and port the server binds inside the container.
# WHITEBOARD_SERVER_HOST=0.0.0.0
# WHITEBOARD_SERVER_PORT=3099

# Seconds of clock drift between your IdP and this server a token tolerates.
# WHITEBOARD_SERVER_JWT_CLOCK_SKEW_SECONDS=60

# Which JWT claim carries the granted scopes: scope or scp.
# WHITEBOARD_SERVER_JWT_SCOPE_CLAIM=scope

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Every workspace but the two script workspaces below is a PRIVATE package
  // (only @kamiazya/whiteboard-mcp publishes, and its public surface is the
  // CLI), so an entry barrel is not public API: an export no workspace
  // imports serves nothing. Without this, knip treats every entry file's
  // exports as used and the barrels accumulate dead surface unseen.
  "includeEntryExports": true,
  // The Vite plugin turns every `import.meta.glob(...)` into an entry with
  // exports analysis skipped. This repo's source-scan guards glob a whole
  // source tree with `{ query: '?raw' }` to READ the text, never to import it
  // (canvas-render's import-guard.test.ts globs `./**/*.ts`; apps/web has
  // twenty such scans), so with the plugin on, every file under those trees
  // became an entry and none of their exports were ever judged. The plugin's
  // only other jobs here are vite.config.ts and index.html entries, which the
  // workspaces below declare themselves.
  "vite": false,
  "workspaces": {
    ".": {
      // The exports of these scripts are a loader's contract (a workflow's
      // `meta`) or a script's own surface, not a package barrel.
      "includeEntryExports": false,
      "entry": [
        ".claude/workflows/*.workflow.mjs",
        ".claude/scripts/*.mjs",
        // Claude Code lifecycle hooks: invoked by .claude/settings.json
        // (PreToolUse/PostToolUse commands), which knip does not parse.
        ".claude/scripts/hooks/*.mjs"
      ],
      "project": [".claude/workflows/**/*.mjs", ".claude/scripts/**/*.mjs", "tools/**/*.mjs"],
      // Biome-plugin lint fixtures: raw files the guard test feeds to
      // `biome lint`, never executed or imported — their imports mimic a
      // real test file for the reader, not for module resolution.
      "ignore": [".claude/scripts/fixtures/**"]
    },
    "tools/checks": {
      // Standalone scripts: their exports are read by tests knip does not
      // follow, not imported across a package boundary.
      "includeEntryExports": false,
      "entry": [
        // CI/test-invoked standalone scripts: run via `node tools/checks/...`
        // (release.yml) or loaded with a dynamically-built path
        // (`join(ROOT, 'tools/checks/src/...')`) from arch-lint's tests, not
        // statically imported within this workspace.
        "src/verify-pack-contents.mjs",
        "src/release-gate-matrix-schema.mjs",
        // run-shared-layer-tests.mjs itself is NOT listed here: knip's
        // GitHub Actions plugin already detects it as an entry from ci.yml's
        // `run: node tools/checks/src/run-shared-layer-tests.mjs` step, and
        // listing it again trips knip's "redundant entry pattern" hint.
        // vitest-projects.mjs, its dependency, still needs a listing of its
        // own: it is also reached by a dynamically-built path
        // (`join(ROOT, 'tools/checks/src/...')`) from arch-lint's tests, which
        // the GitHub Actions plugin has no way to see.
        "src/vitest-projects.mjs"
      ],
      "project": ["src/**/*.mjs"]
    },
    "packages/mcp-server": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      "ignoreIssues": {
        // AUTH_SCOPES (the literal tuple, source of the AuthScope union type)
        // and ALL_AUTH_SCOPES (the same values re-typed as a plain
        // `readonly AuthScope[]` for call sites that need the widened array
        // type rather than the tuple) are both real, independently-consumed
        // exports — not dead code. Knip's "duplicates" check only sees they
        // share one runtime array reference.
        "src/server/security/auth-strategy.ts": ["duplicates"],
        // readDirSafe is exported for sweep-imported-fs-blobs.ts, which was
        // retired along with the per-boot re-import (2026-08-28). It stays
        // exported anyway: migration 0011 is recorded history and must stay
        // byte-identical (see its own doc comment), so the `export` keyword
        // cannot be dropped even though this file is now its only caller.
        "src/server/store/db/migrations/0011-import-fs-blobs.ts": ["exports"]
      }
    },
    "packages/model": {
      "project": ["src/**/*.ts"]
    },
    "packages/codec": {
      "project": ["src/**/*.ts"]
    },
    "tools/arch-lint": {
      // Standalone lint tool invoked via its vitest project
      // (`arch-lint-node`), not imported by any other workspace.
      "entry": ["src/scanner.ts", "src/direction-check.ts", "src/architecture-map.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ports": {
      "project": ["src/**/*.ts"]
    },
    "packages/loro-adapter": {
      "project": ["src/**/*.ts"]
    },
    "packages/daemon-client": {
      "project": ["src/**/*.ts"]
    },
    "packages/facet-engine": {
      "project": ["src/**/*.ts"]
    },
    "packages/facet-ui": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/history": {
      "project": ["src/**/*.ts"]
    },
    "packages/reference-graph": {
      "project": ["src/**/*.ts"]
    },
    "packages/scene": {
      "project": ["src/**/*.ts"]
    },
    "packages/search": {
      "project": ["src/**/*.ts"]
    },
    "packages/server-core": {
      "project": ["src/**/*.ts"]
    },
    "packages/workspace-index": {
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-render": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-visual": {
      // A hand-run regenerator, not a build step: the emoji catalog it
      // writes is committed so a clone builds offline, and it is re-run at
      // a Unicode release. Nothing imports it, and nothing should.
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mjs"]
    },
    "packages/canvas-viewer": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "apps/extension": {
      // vite.config.ts builds src/background.ts (`lib.entry`) and, for
      // Firefox, src/content.ts as a second classic-script build started from
      // closeBundle; knip reads neither path out of the config.
      "entry": ["src/background.ts", "src/content.ts", "vite.config.ts"],
      // A config file's default export is read by Vite, not imported.
      "ignoreIssues": { "vite.config.ts": ["exports"] }
    },
    "apps/web": {
      "entry": [
        // Compile-time-only regression guard (tsc --noEmit fails/passes
        // around it); intentionally never imported at runtime.
        "src/_type-probe.ts",
        // Regenerated on demand via `pnpm --filter @kamiazya/whiteboard-web docs:snapshots`, not imported from
        // the app entry point.
        "src/docs-snapshots/*.docs-snapshot.test.tsx",
        "scripts/*.mjs"
      ],
      "ignoreIssues": {
        // Re-exports whose only purpose is to be resolved by tsc, so the
        // probe fails to compile when a component or contract goes missing.
        "src/_type-probe.ts": ["exports", "types"]
      },
      // `src/**/*.css` is in the project so knip follows `@import "tailwindcss"` /
      // `@import "tw-animate-css"` in src/index.css: without it the `.css`
      // compiler is enabled but its imports are never followed, and both packages
      // needed an ignoreDependencies entry that hid a real unused-dependency
      // answer.
      "project": ["src/**/*.tsx", "src/**/*.ts", "src/**/*.css", "scripts/**/*.mjs"]
    }
  },
  "ignoreDependencies": [
    // The semantic-search embedding runtime. `packages/mcp-server` declares it
    // as an OPTIONAL peerDependency (384MB installed, for a feature that is off
    // by default), so knip attributes the only import statement there and sees
    // nothing left pointing at the root entry. The root devDependency is still
    // load-bearing: it is what makes `search:fetch-model` and
    // `scripts/measure/search-quality-embedding.mjs` runnable from a clone,
    // which is the only place either is ever run.
    "@huggingface/transformers",
    // Referenced only as a createRequire().resolve() string in apps/web's
    // vite.config.ts / vitest.browser.config.ts: the direct devDependency is
    // what makes that resolve legal under pnpm's strict node_modules, and the
    // alias it feeds pins the package's DOM-free build so worker chunks that
    // contain remark can evaluate. Knip only follows import statements.
    "decode-named-character-reference",
    // docs-snapshots `@docs-assets/*` alias resolves through Vite's
    // `resolve.alias` (vitest.docs-snapshots.config.ts) to files under
    // docs/assets/, not an npm package.
    "@docs-assets/architecture.canvas",
    "@docs-assets/canvas-auth-flow.canvas",
    // Loaded via .secretlintrc.json's "rules" list, not a JS/TS import.
    "@secretlint/secretlint-rule-pattern",
    "@secretlint/secretlint-rule-preset-recommend",
    // Resolved from node_modules/.bin/cyclonedx-npm by path at runtime
    // (scripts/release/generate-npm-sbom.mjs), not imported as a module.
    "@cyclonedx/cyclonedx-npm"
  ],
  "ignoreBinaries": [
    // Optional local tooling probed by smoke scripts / distribution tests;
    // present in CI and on release-builder machines but not a project
    // dependency knip can resolve.
    "codex",
    "openssl",
    // Windows' own registry tool: the native host registers itself with it
    // (ADR-0050 decision 9), and the Windows smoke reads the key back.
    "reg",
    // lefthook.yml invokes secretlint via its literal node_modules/.bin path
    // rather than a bare command name, which knip parses as the "binary".
    "node_modules/.bin/secretlint",
    // ImageMagick, used by compose-figure.mjs to build a PR's before/after
    // figure. A developer tool on the visual-evidence path, deliberately not
    // a project dependency: nothing in the shipped product rasterises here,
    // and the figure workflow is run by a human on a machine, not in CI.
    "convert",
    "identify"
  ]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".claude/workflows/*.workflow.mjs",
        ".claude/scripts/*.mjs",
        // Claude Code lifecycle hooks: invoked by .claude/settings.json
        // (PreToolUse/PostToolUse commands), which knip does not parse.
        ".claude/scripts/hooks/*.mjs",
        "tools/check-pr-title.mjs"
      ],
      "project": [".claude/workflows/**/*.mjs", ".claude/scripts/**/*.mjs", "tools/**/*.mjs"]
    },
    "tools/checks": {
      "entry": [
        // CI/test-invoked standalone scripts: run via `node tools/checks/...`
        // (release.yml) or loaded with a dynamically-built path
        // (`join(ROOT, 'tools/checks/src/...')`) from mcp-server's release
        // tests, not statically imported within this workspace.
        "src/ci-workflow-steps.mjs",
        "src/env-scope-scanner.mjs",
        "src/verify-pack-contents.mjs",
        "src/release-gate-matrix-schema.mjs"
      ],
      "project": ["src/**/*.mjs"]
    },
    "packages/mcp-server": {
      "entry": [
        // browser-shared-index.ts re-exports specific members from these
        // two — but apps/web's stricter tsconfig (noUnusedLocals)
        // type-checks these source files wholesale via the
        // "./browser-shared" subpath's "types" resolution, so every local
        // declaration in them must stay `export`ed even when unused
        // elsewhere, or apps/web's typecheck fails on "declared but never
        // read"/"never used" for the bare (non-exported) symbol.
        "src/shared/browser-tracing.ts",
        "src/shared/ws-messages.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"],
      "ignoreIssues": {
        // AUTH_SCOPES (the literal tuple, source of the AuthScope union type)
        // and ALL_AUTH_SCOPES (the same values re-typed as a plain
        // `readonly AuthScope[]` for call sites that need the widened array
        // type rather than the tuple) are both real, independently-consumed
        // exports — not dead code. Knip's "duplicates" check only sees they
        // share one runtime array reference.
        "src/server/security/auth-strategy.ts": ["duplicates"]
      }
    },
    "packages/canvas-model": {
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-codec": {
      "project": ["src/**/*.ts"]
    },
    "tools/arch-lint": {
      // Standalone lint tool invoked via its vitest project
      // (`arch-lint-node`), not imported by any other workspace.
      "entry": ["src/scanner.ts", "src/direction-check.ts", "src/architecture-map.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-ports": {
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-workspace": {
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-render": {
      "project": ["src/**/*.ts"]
    },
    "packages/canvas-viewer": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": [
        // Compile-time-only regression guard (tsc --noEmit fails/passes
        // around it); intentionally never imported at runtime.
        "src/_type-probe.ts",
        // Regenerated on demand via `pnpm docs:snapshots`, not imported from
        // the app entry point.
        "src/docs-snapshots/*.docs-snapshot.test.tsx",
        // Documented common entry point for every surface driving the
        // canvas programmatically (WebMCP tool executor, in-page assistant,
        // debug panel). Some re-exports (createSceneExportHandler,
        // useWhiteboardCommands) are already consumed through this barrel;
        // the rest is the module's intentional forward-looking public
        // surface for those future consumers.
        "src/lib/commands/index.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.tsx", "src/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignoreDependencies": [
    // docs-snapshots `@docs-assets/*` alias resolves through Vite's
    // `resolve.alias` (vitest.docs-snapshots.config.ts) to files under
    // docs/assets/, not an npm package.
    "@docs-assets/architecture.canvas",
    "@docs-assets/canvas-auth-flow.canvas",
    // Tailwind v4 is loaded from CSS (`@import "tailwindcss"` /
    // `@import "tw-animate-css"` in src/index.css); knip does not parse CSS
    // imports, only JS/TS module graphs.
    "tailwindcss",
    "tw-animate-css",
    // apps/web/wrangler.toml drives Cloudflare Pages preview deploys; CI
    // invokes wrangler via `npx wrangler@<pinned>` / cloudflare/wrangler-action
    // rather than this package.json's own devDependency. Kept so a local
    // `pnpm --filter web exec wrangler ...` matches the CI-pinned version.
    "wrangler",
    // Not imported directly anywhere in src — @libsql/kysely-libsql pulls it
    // in transitively — but the direct pin here forces the whole workspace
    // onto a newer @libsql/client (^0.17.3) than kysely-libsql's own range
    // (^0.8.0). See the comment next to the LibsqlDialect import in
    // server/store/db/index.ts.
    "@libsql/client",
    // Loaded via .secretlintrc.json's "rules" list, not a JS/TS import.
    "@secretlint/secretlint-rule-pattern",
    "@secretlint/secretlint-rule-preset-recommend",
    // Resolved from node_modules/.bin/cyclonedx-npm by path at runtime
    // (scripts/release/generate-npm-sbom.mjs), not imported as a module.
    "@cyclonedx/cyclonedx-npm",
    // mcp-server's build reads canvas-viewer's already-built dist/ off disk
    // by relative path (scripts/copy-widget-into-dist.mjs), not via a JS
    // import — the devDependency exists purely so pnpm's workspace graph
    // builds canvas-viewer before mcp-server.
    "@kamiazya/whiteboard-canvas-viewer"
  ],
  "ignoreBinaries": [
    // Optional local tooling probed by smoke scripts / distribution tests;
    // present in CI and on release-builder machines but not a project
    // dependency knip can resolve.
    "claude",
    "codex",
    "openssl",
    // lefthook.yml invokes secretlint via its literal node_modules/.bin path
    // rather than a bare command name, which knip parses as the "binary".
    "node_modules/.bin/secretlint"
  ]
}
